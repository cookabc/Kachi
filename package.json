{
  "name": "kachi",
  "version": "0.1.0",
  "description": "Finance-English learning PWA: offline vocabulary, quizzes, and shareable progress cards",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookabc/Kachi.git"
  },
  "keywords": [
    "pwa",
    "vite",
    "react",
    "vocabulary",
    "english-learning",
    "finance",
    "quiz",
    "gamification"
  ],
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-content.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "node scripts/validate-content.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check": "biome check . && node scripts/validate-content.mjs && tsc --noEmit && vitest run && vite build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workbox-window": "^7.4.1"
  }
}
