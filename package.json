{
  "name": "kachi",
  "version": "0.1.0",
  "description": "Finance-English learning PWA: offline vocabulary, quizzes, and shareable progress cards",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookabc/Kachi.git"
  },
  "keywords": [
    "pwa",
    "vite",
    "react",
    "vocabulary",
    "english-learning",
    "finance",
    "quiz",
    "gamification"
  ],
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-content.mjs && vite build && node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "node scripts/validate-content.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check": "biome check . && node scripts/validate-content.mjs && tsc --noEmit && vitest run && vite build && node scripts/verify-build.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "lefthook install",
    "generate:course": "node scripts/generate-course.mjs",
    "generate:art": "node scripts/generate-art.mjs",
    "generate:audio": "node scripts/generate-audio.mjs",
    "strip:art": "node scripts/strip-art-background.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:built": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-window": "^7.4.1"
  }
}
